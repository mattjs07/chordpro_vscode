{
  "name": "chordpro-vscode",
  "displayName": "ChordPro VSCode",
  "description": "Edit, render, and build ChordPro songs in VSCode — includes PDF rendering, templates, and an interactive chord builder with fretboard.",
  "publisher": "mattjs07",
  "version": "1.14.2",
  "icon": "images/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "chordpro",
    "guitar",
    "chord",
    "music",
    "tabs"
  ],
  "engines": {
    "vscode": "^1.99.0"
  },
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "chordpro",
        "aliases": [
          "ChordPro",
          "chordpro"
        ],
        "extensions": [
          ".cho",
          ".chordpro",
          ".chopro"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "chordpro",
        "scopeName": "source.chordpro",
        "path": "./syntaxes/chordpro.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "chordproLibrary",
          "title": "ChordPro Library",
          "icon": "images/sidebar-icon.svg"
        }
      ],
      "panel": [
        {
          "id": "chordBuilder",
          "title": "Chord Builder",
          "icon": "$(music)"
        }
      ]
    },
    "views": {
      "chordproLibrary": [
        {
          "id": "chordproLibraryView",
          "name": "Song Library",
          "icon": "$(music)"
        },
        {
          "type": "webview",
          "id": "chordproChordReference",
          "name": "Chord Reference"
        }
      ],
      "chordBuilder": [
        {
          "type": "webview",
          "id": "chordproFretboard.chordBuilderView",
          "name": "Chord Builder",
          "icon": "$(music)"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.renderChordPro",
        "title": "ChordPro: Render PDF"
      },
      {
        "command": "extension.previewChordPro",
        "title": "ChordPro: Preview PDF"
      },
      {
        "command": "extension.openChordProMinimalTemplate",
        "title": "ChordPro: New Minimal Template"
      },
      {
        "command": "extension.openChordProExampleTemplate",
        "title": "ChordPro: New Example Template"
      },
      {
        "command": "extension.openChordProTemplate",
        "title": "ChordPro: New Template"
      },
      {
        "command": "chordproFretboard.openBuilder",
        "title": "ChordPro: Open Chord Builder"
      },
      {
        "command": "chordpro.insertTitle",
        "title": "ChordPro: Insert Title"
      },
      {
        "command": "chordproFretboard.insertChordInline",
        "title": "ChordPro: Insert Chord Inline"
      },
      {
        "command": "chordproFretboard.insertChordDiagram",
        "title": "ChordPro: Insert Chord Diagram"
      },
      {
        "command": "extension.configureRendering",
        "title": "ChordPro: Configure Rendering"
      },
      {
        "command": "extension.openChordAnalyzer",
        "title": "ChordPro: Open Chord Analyzer (Oolimo)"
      },
      {
        "command": "extension.autoScrollPreview",
        "title": "ChordPro: Performance View"
      },
      {
        "command": "extension.openTabEditor",
        "title": "ChordPro: Open Tab Editor"
      },
      {
        "command": "extension.transposeChords",
        "title": "ChordPro: Transpose Chords"
      },
      {
        "command": "extension.capoHelper",
        "title": "ChordPro: Capo Helper (Concert Pitch)"
      },
      {
        "command": "extension.detectKey",
        "title": "ChordPro: Detect Key"
      },
      {
        "command": "chordpro.setLibraryFolder",
        "title": "ChordPro: Set Library Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "chordpro.refreshLibrary",
        "title": "ChordPro: Refresh Library",
        "icon": "$(refresh)"
      },
      {
        "command": "chordpro.openSetlistPreview",
        "title": "ChordPro: Play as Setlist",
        "icon": "$(play)"
      },
      {
        "command": "chordpro.previewSongFromLibrary",
        "title": "ChordPro: Preview Song",
        "icon": "$(play)"
      },
      {
        "command": "chordpro.openSong",
        "title": "ChordPro: Open Song"
      },
      {
        "command": "extension.createChordProConfig",
        "title": "ChordPro: Create Config"
      },
      {
        "command": "extension.registerChordProConfig",
        "title": "ChordPro: Import Config to User Library"
      },
      {
        "command": "extension.editChordProConfig",
        "title": "ChordPro: Edit Config"
      },
      {
        "command": "extension.setUserConfigsFolder",
        "title": "ChordPro: Set User Configs Folder"
      },
      {
        "command": "extension.openGridEditor",
        "title": "ChordPro: Open Grid Editor"
      },
      {
        "command": "chordpro.openInBuilder",
        "title": "ChordPro: Open Chord in Builder"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "chordpro.setLibraryFolder",
          "when": "view == chordproLibraryView",
          "group": "navigation"
        },
        {
          "command": "chordpro.refreshLibrary",
          "when": "view == chordproLibraryView",
          "group": "navigation"
        },
        {
          "command": "chordpro.openSetlistPreview",
          "when": "view == chordproLibraryView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "chordpro.previewSongFromLibrary",
          "when": "viewItem == song",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "chordpro.previewSongFromLibrary",
          "when": "false"
        },
        {
          "command": "chordpro.openInBuilder",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "extension.renderChordPro",
        "key": "ctrl+shift+b",
        "when": "editorLangId == 'chordpro'"
      },
      {
        "command": "extension.previewChordPro",
        "key": "ctrl+shift+v",
        "when": "editorLangId == 'chordpro'"
      },
      {
        "command": "chordproFretboard.insertChordInline",
        "key": "ctrl+i",
        "when": "editorTextFocus && editorLangId == 'chordpro'"
      },
      {
        "command": "chordproFretboard.insertChordDiagram",
        "key": "ctrl+shift+d",
        "when": "editorTextFocus && editorLangId == 'chordpro'"
      },
      {
        "command": "chordproFretboard.openBuilder",
        "key": "ctrl+alt+b",
        "when": "editorLangId == 'chordpro'"
      },
      {
        "command": "extension.openChordAnalyzer",
        "key": "ctrl+alt+a",
        "when": "editorLangId == 'chordpro'"
      },
      {
        "command": "extension.autoScrollPreview",
        "key": "ctrl+alt+p",
        "when": "editorLangId == 'chordpro'"
      },
      {
        "command": "extension.openTabEditor",
        "key": "ctrl+alt+t",
        "when": "editorLangId == 'chordpro'"
      },
      {
        "command": "extension.openGridEditor",
        "key": "ctrl+alt+g",
        "when": "editorLangId == 'chordpro'"
      }
    ],
    "configuration": {
      "title": "ChordPro VSCode",
      "properties": {
        "chordpro.buildOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically render ChordPro PDF on file save."
        },
        "chordpro.userConfigsFolder": {
          "type": "string",
          "default": "",
          "description": "Folder for your personal ChordPro config JSON files. Leave empty to use the default VS Code storage location. Set to any folder (e.g. a Dropbox path) to keep configs portable."
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:chordpro",
    "onView:chordproFretboard.chordBuilderView",
    "onCommand:extension.renderChordPro",
    "onCommand:extension.previewChordPro",
    "onCommand:extension.openChordProMinimalTemplate",
    "onCommand:extension.openChordProExampleTemplate",
    "onCommand:extension.openChordProTemplate",
    "onCommand:chordproFretboard.openBuilder",
    "onCommand:chordpro.insertTitle",
    "onCommand:chordproFretboard.insertChordInline",
    "onCommand:chordproFretboard.insertChordDiagram",
    "onCommand:extension.openChordAnalyzer",
    "onCommand:extension.autoScrollPreview",
    "onCommand:extension.openTabEditor",
    "onCommand:extension.transposeChords",
    "onCommand:extension.capoHelper",
    "onCommand:extension.detectKey",
    "onView:chordproLibraryView",
    "onView:chordproChordReference",
    "onCommand:chordpro.setLibraryFolder",
    "onCommand:chordpro.refreshLibrary",
    "onCommand:chordpro.openSetlistPreview",
    "onCommand:chordpro.previewSongFromLibrary",
    "onCommand:chordpro.openSong"
  ],
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.23.0"
  },
  "dependencies": {
    "tonal": "^6.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mattjs07/chordpro_vscode.git"
  },
  "license": "0BSD"
}
