{
  "name": "chordpro-vscode",
  "displayName": "ChordPro VSCode",
  "description": "Edit, render, and build ChordPro songs in VSCode — includes PDF rendering, templates, and an interactive chord builder with fretboard.",
  "publisher": "mattjs07",
  "version": "0.6.0",
  "categories": [
    "Other"
  ],
  "keywords": [
    "chordpro",
    "guitar",
    "chord",
    "music",
    "tabs"
  ],
  "engines": {
    "vscode": "^1.99.0"
  },
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "chordpro",
        "aliases": [
          "ChordPro",
          "chordpro"
        ],
        "extensions": [
          ".cho",
          ".chordpro",
          ".chopro"
        ]
      }
    ],
    "grammars": [
      {
        "language": "chordpro",
        "scopeName": "source.chordpro",
        "path": "./syntaxes/chordpro.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "chordBuilder",
          "title": "Chord Builder",
          "icon": "$(music)"
        }
      ]
    },
    "views": {
      "chordBuilder": [
        {
          "type": "webview",
          "id": "chordproFretboard.chordBuilderView",
          "name": "Chord Builder",
          "icon": "$(music)"
        }
      ]
    },
    "commands": [
      {
        "command": "extension.renderChordPro",
        "title": "Render ChordPro PDF"
      },
      {
        "command": "extension.previewChordPro",
        "title": "Preview ChordPro PDF"
      },
      {
        "command": "extension.openChordProMinimalTemplate",
        "title": "Open ChordPro Minimal Template"
      },
      {
        "command": "extension.openChordProExampleTemplate",
        "title": "Open ChordPro Example Template"
      },
      {
        "command": "extension.openChordProTemplate",
        "title": "Open ChordPro Template"
      },
      {
        "command": "chordproFretboard.openBuilder",
        "title": "Open Chord Builder"
      },
      {
        "command": "chordproFretboard.insertChord",
        "title": "Insert Chord by Name"
      },
      {
        "command": "chordproFretboard.insertChordFromList",
        "title": "Insert Chord from List"
      },
      {
        "command": "extension.configureRendering",
        "title": "Configure ChordPro Rendering"
      },
      {
        "command": "extension.openChordAnalyzer",
        "title": "Open Chord Analyzer (Oolimo)"
      }
    ],
    "keybindings": [
      {
        "command": "extension.renderChordPro",
        "key": "ctrl+shift+b",
        "when": "editorLangId == 'chordpro'"
      },
      {
        "command": "extension.previewChordPro",
        "key": "ctrl+shift+v",
        "when": "editorLangId == 'chordpro'"
      },
      {
        "command": "chordproFretboard.insertChord",
        "key": "ctrl+i",
        "when": "editorTextFocus && editorLangId == 'chordpro'"
      },
      {
        "command": "chordproFretboard.insertChordFromList",
        "key": "ctrl+l",
        "when": "editorTextFocus && editorLangId == 'chordpro'"
      },
      {
        "command": "chordproFretboard.openBuilder",
        "key": "ctrl+alt+d",
        "when": "editorLangId == 'chordpro'"
      },
      {
        "command": "extension.openChordAnalyzer",
        "key": "ctrl+alt+a",
        "when": "editorLangId == 'chordpro'"
      }
    ],
    "configuration": {
      "title": "ChordPro VSCode",
      "properties": {
        "chordpro.buildOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically render ChordPro PDF on file save."
        }
      }
    }
  },
  "activationEvents": [
    "onLanguage:chordpro",
    "onView:chordproFretboard.chordBuilderView",
    "onCommand:extension.renderChordPro",
    "onCommand:extension.previewChordPro",
    "onCommand:extension.openChordProMinimalTemplate",
    "onCommand:extension.openChordProExampleTemplate",
    "onCommand:extension.openChordProTemplate",
    "onCommand:chordproFretboard.openBuilder",
    "onCommand:chordproFretboard.insertChord",
    "onCommand:chordproFretboard.insertChordFromList",
    "onCommand:extension.openChordAnalyzer"
  ],
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.99.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.23.0"
  },
  "dependencies": {
    "tonal": "^6.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mattjs07/chordpro_vscode.git"
  },
  "license": "0BSD"
}
