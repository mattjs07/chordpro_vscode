{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ChordPro",
  "scopeName": "source.chordpro",
  "patterns": [
    { "include": "#comment" },
    { "include": "#section-directive" },
    { "include": "#define-directive" },
    { "include": "#metadata-directive" },
    { "include": "#formatting-directive" },
    { "include": "#generic-directive" },
    { "include": "#chord" }
  ],
  "repository": {

    "comment": {
      "match": "^\\s*#.*$",
      "name": "comment.line.number-sign.chordpro"
    },

    "chord": {
      "match": "(\\[)([A-G][b#]?[^\\]]*)(\\])",
      "captures": {
        "1": { "name": "punctuation.definition.chord.begin.chordpro" },
        "2": { "name": "entity.name.tag.chordpro" },
        "3": { "name": "punctuation.definition.chord.end.chordpro" }
      }
    },

    "section-directive": {
      "match": "(\\{)(start_of_chorus|end_of_chorus|start_of_verse|end_of_verse|start_of_bridge|end_of_bridge|start_of_tab|end_of_tab|start_of_grid|end_of_grid|start_of_textblock|end_of_textblock|soc|eoc|sov|eov|sot|eot)([^}]*)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.directive.chordpro" },
        "2": { "name": "keyword.control.section.chordpro" },
        "3": { "name": "string.unquoted.section.label.chordpro" },
        "4": { "name": "punctuation.definition.directive.chordpro" }
      }
    },

    "define-directive": {
      "match": "(\\{)(define|chord)(:?\\s*)([A-G][b#]?[^\\s}]*)([^}]*)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.directive.chordpro" },
        "2": { "name": "storage.type.directive.chordpro" },
        "3": { "name": "punctuation.separator.chordpro" },
        "4": { "name": "entity.name.tag.chordpro" },
        "5": { "name": "constant.numeric.chordpro" },
        "6": { "name": "punctuation.definition.directive.chordpro" }
      }
    },

    "metadata-directive": {
      "match": "(\\{)(title|subtitle|artist|composer|lyricist|copyright|album|year|key|time|tempo|duration|capo|meta|t|st)(:)([^}]*)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.directive.chordpro" },
        "2": { "name": "support.function.directive.name.chordpro" },
        "3": { "name": "punctuation.separator.key-value.chordpro" },
        "4": { "name": "string.unquoted.directive.value.chordpro" },
        "5": { "name": "punctuation.definition.directive.chordpro" }
      }
    },

    "formatting-directive": {
      "match": "(\\{)(comment|comment_italic|comment_box|image|columns|column_break|new_page|new_physical_page|page_break)(:?)([^}]*)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.directive.chordpro" },
        "2": { "name": "keyword.other.formatting.chordpro" },
        "3": { "name": "punctuation.separator.chordpro" },
        "4": { "name": "string.unquoted.directive.value.chordpro" },
        "5": { "name": "punctuation.definition.directive.chordpro" }
      }
    },

    "generic-directive": {
      "match": "(\\{)([a-z_]+)(:?)([^}]*)(\\})",
      "captures": {
        "1": { "name": "punctuation.definition.directive.chordpro" },
        "2": { "name": "keyword.other.directive.chordpro" },
        "3": { "name": "punctuation.separator.chordpro" },
        "4": { "name": "string.unquoted.directive.value.chordpro" },
        "5": { "name": "punctuation.definition.directive.chordpro" }
      }
    }

  }
}
